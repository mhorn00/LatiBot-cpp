# Normalize line endings: LF in the repository, native in the working tree.
* text=auto

*.cpp text
*.hpp text
*.cmake text
*.json text
*.md text
*.py text
*.yml text
CMakeLists.txt text

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Fuzz seeds are inputs, byte for byte: no line ending conversion.
tests/fuzz/corpus/** -text
