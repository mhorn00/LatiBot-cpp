{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Ninja Multi-Config with MSVC, its dependencies from Conan in build/conan. Needs the Visual Studio developer environment: VS Code's CMake Tools sets it up for Ninja presets, and a terminal needs the Developer PowerShell. Needs: conan export conan/dpp, then conan install . --build=missing -s build_type=Debug, and again with Release (README.md, step 4).",
      "generator": "Ninja Multi-Config",
      "installDir": "${sourceDir}/out/LatiBot",
      "toolchainFile": "${sourceDir}/build/conan/conan_toolchain.cmake",
      "architecture": { "value": "x64", "strategy": "external" },
      "toolset": { "value": "host=x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "default",
      "inherits": "base",
      "displayName": "Debug and Release",
      "description": "The everyday build, and what CI builds. Also writes compile_commands.json, which clang-tidy reads.",
      "binaryDir": "${sourceDir}/build/build"
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "AddressSanitizer",
      "description": "Our targets with /fsanitize=address. Needs the VC.ASAN component.",
      "binaryDir": "${sourceDir}/build/build-asan",
      "cacheVariables": {
        "LATIBOT_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "fuzz",
      "inherits": "base",
      "displayName": "libFuzzer",
      "description": "The fuzz targets in tests/fuzz. Needs the VC.ASAN component.",
      "binaryDir": "${sourceDir}/build/build-fuzz",
      "cacheVariables": {
        "LATIBOT_ENABLE_ASAN": "ON",
        "LATIBOT_BUILD_FUZZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "default", "configuration": "Debug" },
    { "name": "release", "configurePreset": "default", "configuration": "Release" },
    { "name": "asan", "configurePreset": "asan", "configuration": "Debug" },
    { "name": "fuzz", "configurePreset": "fuzz", "configuration": "Debug" }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "default",
      "configuration": "Debug",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "name": "\\[live\\]" } }
    },
    {
      "name": "release",
      "configurePreset": "default",
      "configuration": "Release",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "name": "\\[live\\]" } }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    }
  ],
  "workflowPresets": [
    {
      "name": "debug",
      "displayName": "Debug: configure, build, test",
      "steps": [
        { "type": "configure", "name": "default" },
        { "type": "build", "name": "debug" },
        { "type": "test", "name": "debug" }
      ]
    },
    {
      "name": "release",
      "displayName": "Release: configure, build, test",
      "steps": [
        { "type": "configure", "name": "default" },
        { "type": "build", "name": "release" },
        { "type": "test", "name": "release" }
      ]
    },
    {
      "name": "asan",
      "displayName": "AddressSanitizer: configure, build, test",
      "steps": [
        { "type": "configure", "name": "asan" },
        { "type": "build", "name": "asan" },
        { "type": "test", "name": "asan" }
      ]
    }
  ]
}
