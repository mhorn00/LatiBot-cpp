# Copy this to .env and fill in real values. .env is gitignored — never
# commit real tokens. This file is loaded once at startup and never
# overrides a variable your shell already set (see src/core/util/env.cpp).

DISCORD_BOT_TOKEN=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Certificates are handled for you: the bot exports the operating system's
# trusted roots to data/ca-bundle.pem at startup, because the OpenSSL we link
# ships none of its own. Set this only to override that with your own bundle,
# for instance behind a proxy that re-signs TLS.
# SSL_CERT_FILE=
