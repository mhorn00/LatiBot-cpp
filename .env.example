# Copy this to .env and fill in real values. .env is gitignored — never
# commit real tokens. This file is loaded once at startup and never
# overrides a variable your shell already set (see src/core/util/env.cpp).

DISCORD_BOT_TOKEN=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Certificates are handled for you: the bot exports the operating system's
# trusted roots to data/ca-bundle.pem at startup, because the OpenSSL we link
# ships none of its own. Set this only to override that with your own bundle,
# for instance behind a proxy that re-signs TLS.
# SSL_CERT_FILE=

# Logging. The level defaults to debug in a Debug build and info in Release,
# and this overrides both that and config.json.
# LATIBOT_LOG_LEVEL=debug

# Colour: auto (the default) colours only when stderr is a terminal, so a log
# redirected to a file stays plain. never turns it off; always forces it on.
# LATIBOT_LOG_COLOR=never

# Debug builds only. Makes /linkstats recompute read the replacements another
# account posted, for testing the statistics with a second bot while the
# production one still runs. Its user ID; a release build ignores it.
# LATIBOT_DEBUG_RECOMPUTE_BOT_ID=
