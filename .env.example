# Copy this to .env and fill in real values. .env is gitignored — never
# commit real tokens. This file is loaded once at startup and never
# overrides a variable your shell already set (see src/core/util/env.cpp).

DISCORD_BOT_TOKEN=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Windows only, and only if the bot fails REST calls with "Malformed HTTP
# response": the Conan-built OpenSSL has no CA bundle of its own
# (OPENSSLDIR is empty), so certificate verification fails before any HTTP
# response is read. Point this at a PEM bundle — Git for Windows ships one:
# SSL_CERT_FILE=C:\Program Files\Git\usr\ssl\certs\ca-bundle.crt
