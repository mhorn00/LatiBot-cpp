---
Language: Cpp
BasedOnStyle: Google

ColumnLimit: 120
IndentWidth: 4
AccessModifierOffset: -4
PointerAlignment: Left
DerivePointerAlignment: false

AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLoopsOnASingleLine: false
BreakBeforeBraces: Attach
NamespaceIndentation: None
FixNamespaceComments: true

# Google indents case labels, puts two spaces before a trailing comment and
# only keeps empty functions on one line. This code does none of those, and a
# config that disagrees churns every file it is asked to format.
IndentCaseLabels: false
SpacesBeforeTrailingComments: 1

# Our own headers first, then third-party, then the standard library.
IncludeBlocks: Preserve
SortIncludes: CaseSensitive
