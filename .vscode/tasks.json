{
  "version": "2.0.0",
  "tasks": [
    {
      // Referenced by testMate.cpp.test.advancedExecutables[].runTask.before,
      // so the Testing sidebar always runs the current sources. A no-op build
      // costs about a second.
      "label": "Build tests (Debug)",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "build", "--config", "Debug", "--target", "latibot_tests"],
      "group": "build",
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
